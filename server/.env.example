# ─────────────────────────────────────────────
# MyRentPal — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
PORT=5000

# ── MongoDB ──────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/myrentpal

# ── JWT ──────────────────────────────────────
JWT_SECRET=a3883d59e38759014e7eddd79d304e3441e91fa3bf1e02777a6d536e15bd97c6b8cd8cf133bbbc4b1022803160ceecd3744360adbccb23fd8ce009da797320b1

# ── M-Pesa Daraja API ─────────────────────────
# Get credentials at: https://developer.safaricom.co.ke
# Set MPESA_ENV=sandbox for testing, production for live
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=Ptx5frcNK3GoGy260bqGrgrJmft2hycPsBBKGIWByMNLYBca
MPESA_CONSUMER_SECRET=BmTlIFAQCFGjwTUyn1A777clRjAwLaZ6wDCBOikBGHe7VgNAbppH9jXWN0DNKxvF

# Lipa Na M-Pesa shortcode (sandbox: 174379)
MPESA_SHORTCODE=174379

# Lipa Na M-Pesa passkey (get from Daraja portal)
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Public URL for Safaricom to call back to your server
# For local dev use ngrok: https://xxxxx.ngrok.io
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
MPESA_CONFIRM_URL=https://your-domain.com/api/mpesa/c2b/confirm
MPESA_VALIDATE_URL=https://your-domain.com/api/mpesa/c2b/validate

# ── Twilio WhatsApp ───────────────────────────
# Get credentials at: https://console.twilio.com
# Sandbox sender number (Twilio sandbox): +14155238886
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+14155238886

# ── M-Pesa Paybill (C2B) ──────────────────────
# Public address of this server (for local testing, your ngrok URL)
MPESA_PUBLIC_URL=
# Long random string; it becomes part of the callback URLs so only Safaricom can post payments.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_SECRET=
# Reject payments whose account number matches no tenancy (needs External Validation on the Paybill)
MPESA_REJECT_UNKNOWN_ACCOUNTS=true
# Development only: lets landlords simulate Paybill payments without Safaricom
MPESA_DEV_SIMULATOR=false

# ── SMS receipts (Africa's Talking) ───────────
# Sandbox: AT_USERNAME=sandbox and your sandbox API key from https://account.africastalking.com
# Leave AT_API_KEY empty to only log receipts to the console
AT_USERNAME=sandbox
AT_API_KEY=
# Optional approved sender ID (live accounts only)
AT_SENDER_ID=
